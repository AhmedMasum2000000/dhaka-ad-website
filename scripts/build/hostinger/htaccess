RewriteRule ^robots\.txt$ robots-staging.txt [L]
RewriteCond %{HTTP_HOST} ^(www\.)?dhakaad\.com$ [NC]
RewriteRule ^robots-staging\.txt$ - [R=404,L]
# retired price page -> the cost guide (prices are discussed on the phone, not published)
