# dhakaad.com — copied into the export by scripts/build/export_domain.py
# Keeps every legacy WordPress / old-site URL on a single 301 hop to its new page.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On
RewriteRule (^|/)\.git - [F,L]
# staging guard: any host other than dhakaad.com / www.dhakaad.com gets a Disallow-all robots.txt
# (no X-Robots-Tag header: Hostinger LiteSpeed ignored both <If> and SetEnvIf Host and sent noindex on production, 2026-10-12)
